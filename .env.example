# ---------------------------------------------------------------------------
# .env.example — documents every key the project needs.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. None of them work. Copy this file to
# `.env` and paste in real TEST-MODE credentials.
#
#     Copy-Item .env.example .env
#
# Hard rule from context/code-standards.md: test-mode keys only. No
# production payment credentials in this project, ever.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
APP_ENV=development
# Run all four pipeline stages inside the webhook request, rather than DETECT
# alone. True makes the detect-to-decision latency claim measurable end to end
# through the verified path; it also means the webhook answers in seconds because
# DIAGNOSE calls an LLM. Set false to detect only.
PIPELINE_RUN_INLINE=true
# Bound to loopback on purpose: there is no auth layer on this service
# (context/ui-context.md -> "No auth/login system — this is a local demo tool").
# Do not expose this host/port to a network without adding authentication.
API_HOST=127.0.0.1
API_PORT=8000

# --- Payment provider --------------------------------------------------------
# DECIDED: razorpay (logged in context/progress-tracker.md decisions log).
# Valid values: stripe | razorpay
PAYMENT_PROVIDER=razorpay

# Stripe test mode — UNUSED, provider decision went to Razorpay. Left documented
# in case we ever swap. Test keys start with sk_test_ / pk_test_ / whsec_.
# A key that does NOT start with sk_test_ is rejected at startup by config.py.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay test mode. Test key ids start with rzp_test_.
# A key_id that does NOT start with rzp_test_ is rejected at startup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# NOTE: unlike Stripe, Razorpay does NOT generate this for you — you invent the
# value and type the SAME string into the Razorpay dashboard webhook config and
# here. It is unrelated to RAZORPAY_KEY_SECRET. Generate a strong one locally:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Razorpay signs each webhook with HMAC-SHA256 (hex) over the RAW request body,
# keyed with this secret, in the X-Razorpay-Signature header.
RAZORPAY_WEBHOOK_SECRET=

# --- LLM (DIAGNOSE stage only) ----------------------------------------------
# Gemini free tier. Classification only — the model never calls a payment API.
GEMINI_API_KEY=
# flash-LITE deliberately. This project's key allows only 20 gemini-2.5-flash
# requests PER DAY, which cannot cover the ~27 distinct classifications a demo
# batch needs. Quota is per-model, so flash-lite has its own separate allowance,
# and it is also faster. Check remaining quota before a demo; a 429 escalates
# every event to human review, which is safe but makes the batch prove nothing.
GEMINI_MODEL=gemini-2.5-flash-lite
# Confidence below this is rerouted to `unknown` and escalated to human review
# instead of being acted on. Raising it escalates more; lowering it lets weaker
# guesses drive automated actions. A probe returned a forced guess at exactly
# 0.70, which is why the default sits just above.
DIAGNOSE_CONFIDENCE_THRESHOLD=0.75

# --- Messaging (EXECUTE stage) ----------------------------------------------
# Phase 5. With a channel's credentials blank, EXECUTE runs dry on that channel
# and contacts nobody.

# SendGrid / email — INTENTIONALLY UNUSED for v1. WhatsApp via Twilio is the
# only live channel, so Channel.EMAIL is unreachable in practice. Leave blank.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio — WhatsApp is the live channel: messages carry a Razorpay-hosted
# payment link the customer taps. The agent never processes the payment itself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SENDER — Twilio's shared sandbox number, the same for every sandbox user.
# Must carry the 'whatsapp:' prefix or Twilio returns error 63007.
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# RECIPIENTS — your OWN WhatsApp number(s) in E.164, comma-separated. This is
# not a value Twilio gives you; it is the phone that will receive the messages.
# Each number must first opt in by sending "join <two-word-code>" on WhatsApp to
# the sandbox number above. The code is in the Twilio Console under
# Messaging -> Try it out -> Send a WhatsApp message.
# Sends to numbers that have not opted in are silently dropped, which would
# overstate the recovery metric, so EXECUTE checks against this allowlist.
TWILIO_WHATSAPP_TEST_RECIPIENTS=whatsapp:+919999999999
# No voice channel in this project (context/project-overview.md). Do not add
# a Twilio voice/TwiML credential here.

# --- Storage -----------------------------------------------------------------
# Postgres per context/code-standards.md, run as a container via
# docker-compose.yml at the repo root. Needed from Phase 2 onward, not Phase 0.
#
#   docker compose up -d
#
# POSTGRES_* is the single source of truth. The container creates the role from
# these values, and the app DERIVES its connection URL from the same values, so
# there is nothing to keep in sync by hand.
#
# Set a password of your own choosing — nothing issues this to you. Compose
# refuses to start without it rather than defaulting to something guessable:
#
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
POSTGRES_USER=recovery
POSTGRES_PASSWORD=
POSTGRES_DB=revenue_recovery

# HOST port the container publishes on. Inside the container it is always 5432.
# Default 5432 collides with a native PostgreSQL install if you have one — on
# Windows that surfaces as a confusing "socket in a way forbidden by its access
# permissions" bind error rather than a plain 'port in use'. Check with:
#   netstat -ano | Select-String ":5432"
# This machine runs a native postgresql-x64-18 service, hence 55432.
POSTGRES_PORT=55432

# DATABASE_URL is OPTIONAL. Leave it unset for the container above. Set it only
# to point at a Postgres that docker-compose does not manage (a hosted instance,
# say), in which case it overrides POSTGRES_*. Note: POSTGRES_PASSWORD is read
# by Postgres only on FIRST boot of the volume — changing it later does not
# change the real password until you recreate the volume or ALTER USER.
# DATABASE_URL=

# --- Guardrail configuration -------------------------------------------------
# Values mirror context/architecture.md -> Non-negotiable constraints #4.
# These are enforced in code (guardrails.py), not by prompt instruction.
# They are surfaced here for auditability, NOT so they can be loosened to
# make a demo look better.
MAX_RECOVERY_ATTEMPTS=3
# Delay before retrying an insufficient-funds failure. architecture.md asks for
# payday-aware timing "if data available"; no payday data exists here, so this is
# a flat interval rather than a guess presented as insight.
INSUFFICIENT_FUNDS_RETRY_DAYS=3
MIN_HOURS_BETWEEN_CONTACTS=24
QUIET_HOURS_START_LOCAL=9
QUIET_HOURS_END_LOCAL=20
HARD_STOP_DAYS=7
